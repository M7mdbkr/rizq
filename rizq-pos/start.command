#!/bin/bash
# رزق POS — الكاشير فقط، بدون الوكيل الذكي.
# ⚠️  هذا الملف يشغّل الكاشير على المنفذ 4173 بدون أي API، فالمساعد الذكي
#     ما بيشتغل منه. للنظام الكامل استخدم "تشغيل رزق.command" في المجلد الأعلى.
cd "$(dirname "$0")" || exit 1
PORT=4173
clear
echo "================================================================"
echo "  ⚠️  تنبيه: هذا الوضع يشغّل الكاشير فقط — بدون المساعد الذكي."
echo "      للنظام الكامل (كاشير + وكيل): افتح المجلد الأعلى وشغّل"
echo "      \"تشغيل رزق.command\""
echo "================================================================"
echo
read -r -p "تبي تكمل بالكاشير فقط؟ [y/N]: " ANSWER
case "$ANSWER" in
  [yY]|[nN][aA][mM]|[نN]) ;;
  *) echo "أُلغي. استخدم \"تشغيل رزق.command\"."; sleep 2; exit 0 ;;
esac
echo "================================================================"
echo "  رزق POS (كاشير فقط) يعمل الآن"
echo "  على هذا الجهاز:   http://localhost:$PORT"
IP=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null)
[ -n "$IP" ] && echo "  من الآيباد/الجوال: http://$IP:$PORT"
echo "  (نفس شبكة الواي فاي)"
echo "================================================================"
( sleep 1 && open "http://localhost:$PORT" ) &
python3 -m http.server "$PORT"
